# ==========================================
# RailMitra — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==========================================

# --- Railway Data Provider ---
# Options: "mock" (default, no API key needed) or "railradar" (live data)
RAILWAY_PROVIDER=mock

# RailRadar API key — get one at https://railradar.in/developers
# Format: rr_live_xxxxxxxxxxxxx
RAILRADAR_API_KEY=rr_live_YOUR_KEY_HERE
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# --- AI Provider (Google Gemini) ---
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model name — change if you want a different Gemini model
# Options: gemini-2.0-flash (recommended), gemini-1.5-pro, gemini-1.5-flash
AI_MODEL=gemini-2.0-flash

# --- Server Configuration ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX=100
